# Local secrets — never commit. Copy values from your Neon dashboard and Gemini console.
# Gemini API key for the Google GenAI model.
GEMINI_API_KEY=
# DB_URL must be a JDBC URL (note the jdbc: prefix and channelBinding spelling):
# jdbc:postgresql://<host>:5432/neondb?sslmode=require&channelBinding=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=
